# ==============================================================================
# Zustand Public School ERP — Backend Environment Configuration
# ==============================================================================

# PostgreSQL Connection String (e.g. Neon, Supabase, Render Postgres, Railway)
DATABASE_URL="postgresql://username:password@hostname:5432/zustand_school_erp?sslmode=require"

# Server Port (Render sets this automatically via process.env.PORT)
PORT=4000

# JSON Web Token Secret & Expiration
JWT_SECRET="zustand_erp_production_jwt_secret_change_me_in_prod_2026"
JWT_EXPIRATION="7d"

# Node Environment
NODE_ENV="production"
